      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="LUỒNG PHÊ DUYỆT: xét giá trị chênh lệch VÀ người lập. ≤ Z tự duyệt (không áp dụng tăng ca); ≤ X lên D1 (chỉ khi người lập là NV); ≤ Y lên D2 (Thủ kho lập bắt đầu từ D2); vượt Y hoặc Quản lý lập lên D3; tăng ca vào thẳng D2. Người lập không bao giờ tự duyệt (SoD, mọi cấp); duyệt thay theo approval_delegations. Mỗi cấp: duyệt / từ chối / leo thang (trừ D3) / cần thêm thông tin / đếm lại (nét đứt). HỆ QUẢ NHÁNH CUỐI (trigger fn_approval_mirror_status): GRN REJECTED → pallet REJECTED_PENDING_RETURN → xuất trả NCC; kiểm kê REJECTED → đóng dòng, mở khóa vị trí; điều chỉnh/hủy hàng REJECTED hoặc EXPIRED → execution_status NOT_APPLICABLE." vertex="1">
          <mxGeometry height="50" width="2620" as="geometry" />
        </mxCell>
        <mxCell id="lane0" parent="1" style="swimlane;horizontal=0;startSize=40;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e8eef4;swimlaneFillColor=#f5f5f5;strokeColor=#9bb0c4;" value="Hệ thống / Người đề xuất" vertex="1">
