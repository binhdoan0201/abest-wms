        <mxCell id="note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="LUỒNG NHẬP KHO: PO → ASN → nhận hàng đếm mù/GRN → (nếu lệch: cách ly + phê duyệt, có thể đếm lại) → GRN APPROVED (cộng PO) → STAGED → cất hàng → đồng bộ ERP. Nhận hàng không có PO/ASN theo blind_receipt_policy (REJECT hoặc WARN_HOLD_D1)." vertex="1">
          <mxGeometry height="50" width="2830" as="geometry" />
        </mxCell>
        <mxCell id="lane0" parent="1" style="swimlane;horizontal=0;startSize=40;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e8eef4;swimlaneFillColor=#f5f5f5;strokeColor=#9bb0c4;" value="ERP / Hệ thống" vertex="1">
