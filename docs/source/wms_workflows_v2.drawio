        </mxCell>
        <mxCell id="w2" parent="lane0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Yêu cầu ERP hủy dòng; ERP chốt CANCELLED (QL-5.1.s8)&lt;br&gt;&lt;i style=&#39;font-size:9px;color:#555&#39;&gt;(REQUEST_ERP_CANCEL)&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="200" x="1150" y="28" as="geometry" />
        </mxCell>
        <mxCell id="o2" parent="lane0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Cấp phát tồn theo FEFO/FIFO (ưu tiên lô is_priority_dispatch)&lt;br&gt;&lt;i style=&#39;font-size:9px;color:#555&#39;&gt;(qty_allocated, tx ALLOCATE)&lt;/i&gt; (ghi từng balance giữ hàng vào inventory_allocations)" vertex="1">
          <mxGeometry height="85" width="185" x="350" y="37.5" as="geometry" />
        </mxCell>
