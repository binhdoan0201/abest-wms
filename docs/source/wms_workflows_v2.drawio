  <diagram name="2. Xuất kho" id="flow2">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="LUỒNG XUẤT KHO: đơn ERP (SO / chuyển kho / xuất trả NCC) → cấp phát → soạn (ngoại lệ → xử lý thiếu) → đóng gói → chờ vận đơn → lập GI → tài xế ký (trừ SUPPLIER_RETURN) → trừ tồn (SHIPPED). ERP có thể đổi/hủy đơn bất kỳ lúc nào (erp_change_pending)." vertex="1">
          <mxGeometry height="50" width="3250" as="geometry" />
        </mxCell>
        <mxCell id="lane0" parent="1" style="swimlane;horizontal=0;startSize=40;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e8eef4;swimlaneFillColor=#f5f5f5;strokeColor=#9bb0c4;" value="ERP / Hệ thống" vertex="1">
