  <diagram name="4. Kiểm kê &amp; điều chỉnh" id="flow4">
    <mxGraphModel dx="2555" dy="1410" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="LUỒNG KIỂM KÊ: khóa vị trí → đếm mù → so snapshot → trong dung sai Z thì tự ghi nhận; vượt thì đếm lại tới giới hạn (recount_count &lt; max_recount_attempts), sau đó gửi duyệt chênh lệch kiểm kê (CYCLE_COUNT_DIFF). Phiếu tự đóng khi mọi dòng đạt AUTO_APPROVED_Z/APPROVED." vertex="1">
          <mxGeometry height="50" width="2620" as="geometry" />
        </mxCell>
        <mxCell id="lane0" parent="1" style="swimlane;horizontal=0;startSize=40;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e8eef4;swimlaneFillColor=#f5f5f5;strokeColor=#9bb0c4;" value="Thủ kho / Điều phối" vertex="1">
          <mxGeometry height="160" width="2680" y="60" as="geometry" />
        </mxCell>
        <mxCell id="k14" parent="lane0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Giữ nguyên tồn, đóng dòng (status REJECTED)" vertex="1">
          <mxGeometry height="90" width="190" x="2070" y="30" as="geometry" />
        </mxCell>
        <mxCell id="lane1" parent="1" style="swimlane;horizontal=0;startSize=40;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e8eef4;swimlaneFillColor=#ffffff;strokeColor=#9bb0c4;" value="NV kiểm kê" vertex="1">
          <mxGeometry height="160" width="2680" y="220" as="geometry" />
        </mxCell>
        <mxCell id="lane2" parent="1" style="swimlane;horizontal=0;startSize=40;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e8eef4;swimlaneFillColor=#f5f5f5;strokeColor=#9bb0c4;" value="Hệ thống" vertex="1">
          <mxGeometry height="160" width="2680" y="380" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="lane2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Lệch so với snapshot? (gồm EMPTY_LOCATION / UNKNOWN_ITEM)" vertex="1">
          <mxGeometry height="110" width="190" x="860" y="25" as="geometry" />
        </mxCell>
        <mxCell id="k8" parent="lane2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Tự ghi nhận (AUTO_APPROVED_Z), điều chỉnh tồn&lt;br&gt;&lt;i style=&#39;font-size:9px;color:#555&#39;&gt;(inventory_transactions)&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="165" x="1330" y="45" as="geometry" />
        </mxCell>
        <mxCell id="k15" parent="lane2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;Mở khóa vị trí, đóng phiếu (trigger khi mọi dòng đã xử lý xong) - dòng ∈ AUTO_APPROVED_Z / ADJUSTED / REJECTED; không mở nếu phiếu khác còn khóa&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="200" x="2460" y="31" as="geometry" />
        </mxCell>
        <mxCell id="x7" edge="1" parent="lane2" source="k5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#456;" target="k15" value="Không lệch → dòng AUTO_APPROVED_Z">
