# Môi trường chạy (development / production / testing)
ENV=development
DEBUG=True

# Cấu hình kết nối CSDL PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abest_wms
DB_USER=wms_admin
DB_PASSWORD=wms_secret_pass
DATABASE_URL=postgresql+psycopg://wms_admin:wms_secret_pass@localhost:5432/abest_wms

# Cấu hình bảo mật và JWT
SECRET_KEY=change-this-in-production-dev-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Cấu hình Server FastAPI
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_API_URL=http://localhost:8000/api/v1

# Cấu hình Client Web
CLIENT_HOST=0.0.0.0
CLIENT_PORT=3000
